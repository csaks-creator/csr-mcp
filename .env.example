# Copy to .env (never commit it).
# API key from https://nova.amazon.com/act
NOVA_ACT_API_KEY=
# Shared secret between client and server; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_TOKEN=
# Optional comma-separated host patterns the browser may visit, e.g. example.com,*.example.org
ALLOWED_DOMAINS=
